color = "Species"
) +
theme_classic() +
theme(
axis.text.x = element_text(size = 11),
axis.text.y = element_text(size = 11)
)
Fig_1_Line
model_nb_log <- MASS::glm.nb(eddmaps_number_of_obs ~ log(inat_number_of_obs + 1),
data = iNatandEddMap_matched)
